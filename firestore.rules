rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these Google accounts can read or change the shop data.
    // Put your own and your staff's Gmail addresses here, in lower case, then Publish.
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'owner@gmail.com',
          'staff@gmail.com'
        ];
    }
    match /{document=**} {
      allow read, write: if allowed();
    }
  }
}
